# Copy this file to ".env" and fill in real values. NEVER commit ".env".
# MongoDB Atlas connection string (Atlas > Connect > Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Database name used by this project
MONGODB_DB=blinkit_support
# Google AI Studio API key (aistudio.google.com > Get API key). Server-side only.
GEMINI_API_KEY=
# Gemini model (optional). Any Gemini model that supports function calling.
GEMINI_MODEL=gemini-2.5-flash
# Optional: how long to wait for MongoDB before giving up, in ms (default 8000).
# MONGODB_TIMEOUT_MS=8000
# Optional: how long to wait for each Gemini call, in ms (default 15000).
# GEMINI_TIMEOUT_MS=15000
# Optional: minimum milliseconds between Gemini requests (free tier = 5/min => 13000).
# GEMINI_MIN_INTERVAL_MS=13000

# Required on Vercel: a long random secret used to hash visitor IP addresses for rate limiting.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SALT=
# Optional: total chat messages per day for the whole app (default 100). Match this to your
# Gemini quota; each chat message uses 2-3 Gemini requests. Free tier = very small.
# GLOBAL_DAILY_CHAT_LIMIT=100
