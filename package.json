{
  "name": "blinkit-support-agent",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "seed": "tsx --env-file=.env scripts/seed.ts",
    "db:check": "tsx --env-file=.env scripts/checkDb.ts",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "test": "tsx --test tests/validation.test.ts tests/refundRules.test.ts tests/support.test.ts tests/agent.test.ts tests/chat.test.ts tests/chatLogic.test.ts tests/rateLimit.test.ts tests/diagnostics.test.ts tests/testOrderTools.test.ts",
    "test:live": "tsx --env-file=.env --test tests/api.live.test.ts tests/refund.live.test.ts tests/support.live.test.ts tests/rateLimit.live.test.ts",
    "db:deliver": "tsx --env-file=.env scripts/markOrderDelivered.ts",
    "db:indexes": "tsx --env-file=.env scripts/ensureIndexes.ts",
    "test:ai": "tsx --env-file=.env --test tests/agent.live.test.ts",
    "check:api": "tsx scripts/checkApiBundle.ts",
    "verify": "npm run lint && npm run build && npm test && npm run check:api",
    "check:secrets": "tsx scripts/checkSecrets.ts"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "mongodb": "^7.8.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "oxlint": "^1.89.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": "22.x"
  }
}
